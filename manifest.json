{
  "manifest_version": 3,
  "name": "Copy URL Shortcut",
  "version": "1.1.1",
  "description": "Arc-style Shift-Cmd-C: copy the current tab's URL from anywhere, with tracking parameters removed and a small confirmation toast. Ctrl-Shift-C copies it as a Markdown link.",
  "author": "Harry Twyford",
  "homepage_url": "https://github.com/htwyford/copy-url-shortcut",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "notifications",
    "storage"
  ],
  "background": {
    "scripts": [
      "clean.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current tab's URL"
    },
    "copy-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Copy the current tab as a Markdown link"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-url-shortcut@harrytwyford.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
